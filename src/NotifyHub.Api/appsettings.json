{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NotifyHub": ""
  },
  "Api": {
    "MaxRequestBodyBytes": 1048576,
    "EnableOpenApi": true
  },
  "Health": {
    "Worker": {
      "StaleAfter": "00:02:00"
    }
  }
}

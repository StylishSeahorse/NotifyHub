# Copy to deploy/.env and replace every placeholder. Never commit deploy/.env.

# Public DNS name clients and browsers use. "localhost" uses Caddy's internal CA (testing only).
NOTIFYHUB_DOMAIN=notifyhub.example.com
NOTIFYHUB_HTTP_PORT=80
NOTIFYHUB_HTTPS_PORT=443

# Image tag for locally built or registry images.
NOTIFYHUB_VERSION=local

# PostgreSQL. Generate a long random password, e.g.: openssl rand -base64 36
POSTGRES_DB=notifyhub
POSTGRES_USER=notifyhub
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
